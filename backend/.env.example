# Copy to .env (never commit .env). Every value below is optional.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Calculation
SWE_EPHE_PATH=            # folder with Swiss Ephemeris .se1 files; empty = built-in Moshier fallback
EPHEMERIS_MODE=auto       # auto | moshier
DASHA_YEAR_DAYS=365.25    # dasha year-length convention
TRANSIT_ORB_DEGREES=3.0

# Optional AI (Ask Your Kundli). Leave empty to disable; chart calculation does not need it.
LLM_PROVIDER=             # anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=                # e.g. claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=30

# Optional Supabase (accounts/persistence). Not required to run locally.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=
